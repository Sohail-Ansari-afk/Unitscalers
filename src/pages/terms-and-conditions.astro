---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Terms & Conditions | Unitscalers"
  description="Terms and Conditions for Unitscalers."
>
  <section class="py-16 md:py-24 border-b border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 md:px-12">
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight mb-6 text-center text-brand-dark dark:text-white">Terms & Conditions</h1>
      <p class="text-center text-gray-500 dark:text-gray-400 font-mono text-xs md:text-sm">Last updated: 22 August 2026</p>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-white dark:bg-black">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 md:px-12 prose prose-lg dark:prose-invert text-gray-700 dark:text-gray-300">
      <p class="text-base md:text-lg">Welcome to Unitscalers. By accessing or using our website (unitscalers.com) or engaging our services, you agree to the following terms and conditions.</p>

      <h3 class="text-xl font-bold font-sans tracking-tight mt-8 mb-4 text-brand-dark dark:text-white">1. Services</h3>
