---
import Layout from '../layouts/Layout.astro';

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Should I post from my personal profile or my company page?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Your personal profile should be the primary channel — personal profiles consistently outperform company pages in reach on LinkedIn, with estimates ranging from roughly 2x to 5x depending on the study."
      }
    },
    {
      "@type": "Question",
      "name": "How often should a founder post on LinkedIn?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most founders see meaningful engagement growth posting 3-5 times per week, provided the content stays specific to their actual expertise rather than generic advice."
      }
    },
    {
      "@type": "Question",
      "name": "Why do carousels outperform text posts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Carousels currently produce the highest average engagement of any LinkedIn format — around 6.6% — because the swipe interaction drives additional engagement signals the algorithm reads as strong content."
      }
    },
    {
      "@type": "Question",
      "name": "Does LinkedIn outreach actually work, or does it feel like spam?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "It depends entirely on sequencing. Outreach sent to people who've already engaged with your content converts far better. In one B2B study, 91% of buyers said they'd respond to outreach from someone whose content they already followed."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to see results from LinkedIn growth efforts?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Engagement and profile-view growth typically becomes visible within the first several weeks. Inbound messages and booked calls usually take two to three months, since they depend on accumulated content history and audience trust."
      }
    },
    {
      "@type": "Question",
      "name": "Is LinkedIn worth prioritizing if my customers aren't there?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Often yes — LinkedIn's audience skews heavily toward people who influence business decisions: partnerships, hiring, fundraising, and supplier relationships, not just direct sales."
      }
    },
    {
      "@type": "Question",
      "name": "What's the difference between a LinkedIn ghostwriter and a LinkedIn management agency?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A ghostwriter handles writing only. A management agency like UnitScalers combines writing, design, outreach, and reporting into one system, allowing outreach and content to be sequenced together — where most of the compounding effect comes from."
      }
    }
  ]
});
---

<Layout
  title="UnitScalers — LinkedIn Growth, Run Like Performance Marketing"
  description="UnitScalers builds and manages LinkedIn presence for founders and entrepreneurs — content, carousels, and outreach — tracked with the same attribution discipline as a paid ad account."
  schema={faqSchema}
>

<!-- ═══════════════════════════════════════════
     NAVBAR
═══════════════════════════════════════════ -->
<header class="sticky top-0 z-50 bg-[#ffffff]/80 backdrop-blur-md border-b border-[#ebebeb] transition-all">
  <nav class="max-w-[1400px] mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 no-underline group" aria-label="UnitScalers home">
      <img src="/favicon.svg" alt="UnitScalers logo" class="w-7 h-7 object-contain group-hover:scale-105 transition-transform" />
      <span class="text-[#171717] font-semibold text-[15px] tracking-tight">UnitScalers</span>
    </a>

    <!-- Desktop Nav Links -->
    <div class="hidden md:flex items-center gap-1">
      <a href="#metrics" class="text-[#4d4d4d] text-[14px] px-3.5 py-1.5 rounded-full hover:text-[#171717] hover:bg-[#fafafa] transition-colors">Metrics</a>
      <a href="#how-it-works" class="text-[#4d4d4d] text-[14px] px-3.5 py-1.5 rounded-full hover:text-[#171717] hover:bg-[#fafafa] transition-colors">How It Works</a>
      <a href="#calculator" class="text-[#4d4d4d] text-[14px] px-3.5 py-1.5 rounded-full hover:text-[#171717] hover:bg-[#fafafa] transition-colors">Reach Calculator</a>
      <a href="#pricing" class="text-[#4d4d4d] text-[14px] px-3.5 py-1.5 rounded-full hover:text-[#171717] hover:bg-[#fafafa] transition-colors">Pricing</a>
      <a href="#faq" class="text-[#4d4d4d] text-[14px] px-3.5 py-1.5 rounded-full hover:text-[#171717] hover:bg-[#fafafa] transition-colors">FAQ</a>
    </div>

    <!-- Desktop CTA -->
    <div class="hidden md:flex items-center gap-2">
      <a
        href="#contact"
        id="nav-cta-audit"
        class="bg-[#171717] text-white text-[14px] font-medium px-4 py-2 rounded-[6px] hover:bg-[#2a2a2a] hover:shadow-md transition-all active:scale-[0.98]"
      >
        Book a Free Audit
      </a>
    </div>

    <!-- Mobile Hamburger -->
    <button
      id="hamburger-btn"
      aria-label="Open menu"
      class="md:hidden flex flex-col gap-1.5 p-2 rounded-lg hover:bg-[#f5f5f5]"
      onclick="document.getElementById('mobile-menu').classList.toggle('open')"
    >
      <span class="block w-5 h-0.5 bg-[#171717]"></span>
      <span class="block w-5 h-0.5 bg-[#171717]"></span>
      <span class="block w-5 h-0.5 bg-[#171717]"></span>
    </button>
  </nav>

  <!-- Mobile Menu Overlay -->
  <div
    id="mobile-menu"
    class="md:hidden flex-col absolute top-16 left-0 right-0 bg-[#ffffff] border-b border-[#ebebeb] px-6 py-4 gap-1 shadow-xl"
  >
    <a href="#metrics" onclick="document.getElementById('mobile-menu').classList.remove('open')" class="block text-[#4d4d4d] text-[15px] py-2.5 border-b border-[#ebebeb]">Metrics & Charts</a>
    <a href="#how-it-works" onclick="document.getElementById('mobile-menu').classList.remove('open')" class="block text-[#4d4d4d] text-[15px] py-2.5 border-b border-[#ebebeb]">How It Works</a>
    <a href="#calculator" onclick="document.getElementById('mobile-menu').classList.remove('open')" class="block text-[#4d4d4d] text-[15px] py-2.5 border-b border-[#ebebeb]">Reach Calculator</a>
    <a href="#pricing" onclick="document.getElementById('mobile-menu').classList.remove('open')" class="block text-[#4d4d4d] text-[15px] py-2.5 border-b border-[#ebebeb]">Pricing</a>
    <a href="#faq" onclick="document.getElementById('mobile-menu').classList.remove('open')" class="block text-[#4d4d4d] text-[15px] py-2.5 border-b border-[#ebebeb]">FAQ</a>
    <div class="pt-3">
      <a
        href="#contact"
        class="block w-full text-center bg-[#171717] text-white text-[14px] font-medium px-4 py-2.5 rounded-[6px]"
        onclick="document.getElementById('mobile-menu').classList.remove('open')"
      >
        Book a Free Audit
      </a>
    </div>
  </div>
</header>


<!-- ═══════════════════════════════════════════
     HERO WITH MOTION DASHBOARD MOCKUP
═══════════════════════════════════════════ -->
<section class="relative overflow-hidden bg-[#ffffff] px-6 pt-20 pb-20 md:pt-28 md:pb-32">

  <!-- Mesh Gradient Backdrop -->
  <div class="mesh-gradient absolute inset-0 pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-[1400px] mx-auto">
    <!-- Hero Text Header -->
    <div class="text-center max-w-[840px] mx-auto mb-12">
      <!-- Eyebrow badge -->
      <div class="inline-flex items-center gap-2 bg-[#ffffff]/90 border border-[#ebebeb] backdrop-blur-md rounded-full px-3.5 py-1 mb-6 shadow-xs animate-fade-in-up">
        <span class="w-2 h-2 rounded-full bg-[#50e3c2] animate-ping inline-block"></span>
        <span class="font-mono text-[12px] text-[#4d4d4d] tracking-wide font-medium">LinkedIn Management Agency for Founders</span>
      </div>

      <!-- Headline -->
      <h1 class="text-[#171717] font-semibold text-[42px] md:text-[56px] lg:text-[66px] leading-[1.04] tracking-[-2.4px] mb-6">
        LinkedIn Growth, Run Like Performance Marketing.
      </h1>

      <!-- Sub-headline -->
      <p class="text-[#4d4d4d] text-[18px] md:text-[21px] leading-[1.6] max-w-[660px] mx-auto mb-9">
        We build and manage your LinkedIn presence — content, carousels, and outreach — tracked with the same attribution discipline as a paid ad account.
      </p>

      <!-- CTA Row -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="#contact"
          id="hero-cta-primary"
          class="bg-[#171717] text-white text-[16px] font-medium px-8 py-3.5 rounded-[100px] hover:bg-[#2a2a2a] hover:shadow-lg transition-all transform hover:-translate-y-0.5 w-full sm:w-auto text-center"
        >
          Book a Free LinkedIn Audit
        </a>
        <a
          href="#metrics"
          id="hero-cta-secondary"
          class="bg-[#ffffff] text-[#171717] text-[16px] font-medium px-8 py-3.5 rounded-[100px] border border-[#ebebeb] hover:bg-[#fafafa] transition-all w-full sm:w-auto text-center"
        >
          Explore Motion Metrics ↓
        </a>
      </div>

      <p class="mt-4 text-[#888888] text-[13px]">
        We'll show you 3 specific gaps in your current profile and content — no generic advice.
      </p>
    </div>

    <!-- Live Performance Dashboard Visual Mockup -->
    <div class="relative max-w-[1060px] mx-auto mt-8 reveal-on-scroll">
      
      <!-- Ambient Glow Behind Card -->
      <div class="absolute -inset-4 bg-gradient-to-r from-[#007cf0]/20 via-[#7928ca]/20 to-[#ff0080]/20 rounded-[24px] blur-2xl opacity-60 animate-pulse-glow"></div>

      <!-- Main Motion Dashboard Card -->
      <div class="relative bg-[#ffffff]/90 backdrop-blur-xl rounded-[16px] border border-[#ebebeb] p-6 md:p-8 card-elevation-3">
        
        <!-- Dashboard Top Header Bar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-[#ebebeb]">
          <div class="flex items-center gap-3">
            <div class="w-3 h-3 rounded-full bg-[#ee0000]/60"></div>
            <div class="w-3 h-3 rounded-full bg-[#f5a623]/60"></div>
            <div class="w-3 h-3 rounded-full bg-[#29bc9b]/60"></div>
            <span class="font-mono text-[13px] text-[#888888] ml-2">unitscalers_attribution_engine // founder_live_dashboard.v2</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#aaffec]/40 text-[#29bc9b] font-mono text-[12px] font-medium">
              <span class="w-1.5 h-1.5 rounded-full bg-[#29bc9b] animate-pulse"></span> Live Attribution Active
            </span>
          </div>
        </div>

        <!-- Metric Scorecards Row -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 my-6">
          
          <div class="p-4 rounded-[12px] bg-[#fafafa] border border-[#ebebeb] hover:border-[#a1a1a1] transition-colors">
            <div class="font-mono text-[11px] text-[#888888] uppercase tracking-wider mb-1">Organic Reach Multiplier</div>
            <div class="text-[#171717] font-semibold text-[26px] md:text-[30px] tracking-tight flex items-baseline gap-2">
              <span>3.8x</span>
              <span class="text-[#29bc9b] text-[13px] font-normal font-mono">↑ vs Co Page</span>
            </div>
            <div class="text-[12px] text-[#888888] mt-1">Personal profile engine</div>
          </div>

          <div class="p-4 rounded-[12px] bg-[#fafafa] border border-[#ebebeb] hover:border-[#a1a1a1] transition-colors">
            <div class="font-mono text-[11px] text-[#888888] uppercase tracking-wider mb-1">Avg Carousel Rate</div>
            <div class="text-[#171717] font-semibold text-[26px] md:text-[30px] tracking-tight flex items-baseline gap-2">
              <span>6.6%</span>
              <span class="text-[#0070f3] text-[13px] font-normal font-mono">+3.4% format surge</span>
            </div>
            <div class="text-[12px] text-[#888888] mt-1">Multi-slide swipe engine</div>
          </div>

          <div class="p-4 rounded-[12px] bg-[#fafafa] border border-[#ebebeb] hover:border-[#a1a1a1] transition-colors">
            <div class="font-mono text-[11px] text-[#888888] uppercase tracking-wider mb-1">Warm Outreach Response</div>
            <div class="text-[#171717] font-semibold text-[26px] md:text-[30px] tracking-tight flex items-baseline gap-2">
              <span>91%</span>
              <span class="text-[#7928ca] text-[13px] font-normal font-mono">High-intent</span>
            </div>
            <div class="text-[12px] text-[#888888] mt-1">Nurtured connection DMs</div>
          </div>

          <div class="p-4 rounded-[12px] bg-[#fafafa] border border-[#ebebeb] hover:border-[#a1a1a1] transition-colors">
            <div class="font-mono text-[11px] text-[#888888] uppercase tracking-wider mb-1">Pipeline Calls Booked</div>
            <div class="text-[#171717] font-semibold text-[26px] md:text-[30px] tracking-tight flex items-baseline gap-2">
              <span>14 / mo</span>
              <span class="text-[#29bc9b] text-[13px] font-normal font-mono">Verified</span>
            </div>
            <div class="text-[12px] text-[#888888] mt-1">Profile → DM → Calendar</div>
          </div>

        </div>

        <!-- Motion SVG Growth Curve Chart -->
        <div class="p-5 rounded-[12px] bg-[#171717] text-white relative overflow-hidden">
          <div class="flex items-center justify-between mb-4">
            <div>
              <div class="font-mono text-[12px] text-[#a1a1a1] uppercase">Founders Growth Trajectory</div>
              <div class="text-[16px] font-medium text-white">Attribute Profile Traffic to Booked Calls</div>
            </div>
            <div class="flex items-center gap-3 font-mono text-[12px]">
              <span class="flex items-center gap-1 text-[#50e3c2]"><span class="w-2 h-2 rounded-full bg-[#50e3c2]"></span> Content Reach</span>
              <span class="flex items-center gap-1 text-[#ff0080]"><span class="w-2 h-2 rounded-full bg-[#ff0080]"></span> Inbound DMs</span>
            </div>
          </div>

          <!-- Motion SVG Chart Lines -->
          <div class="h-44 w-full relative">
            <svg class="w-full h-full overflow-visible" viewBox="0 0 800 180" preserveAspectRatio="none">
              <defs>
                <linearGradient id="chartGradient1" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#50e3c2" stop-opacity="0.4"/>
                  <stop offset="100%" stop-color="#50e3c2" stop-opacity="0"/>
                </linearGradient>
                <linearGradient id="chartGradient2" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#ff0080" stop-opacity="0.3"/>
                  <stop offset="100%" stop-color="#ff0080" stop-opacity="0"/>
                </linearGradient>
              </defs>
              
              <!-- Grid lines -->
              <line x1="0" y1="30" x2="800" y2="30" stroke="#333333" stroke-dasharray="4,4" />
              <line x1="0" y1="80" x2="800" y2="80" stroke="#333333" stroke-dasharray="4,4" />
              <line x1="0" y1="130" x2="800" y2="130" stroke="#333333" stroke-dasharray="4,4" />

              <!-- Area Fill 1 -->
              <path d="M0,150 Q200,140 350,70 T800,20 L800,180 L0,180 Z" fill="url(#chartGradient1)" />
              <!-- Motion Stroke Line 1 -->
              <path d="M0,150 Q200,140 350,70 T800,20" fill="none" stroke="#50e3c2" stroke-width="3.5" class="animate-dash-flow" />

              <!-- Area Fill 2 -->
              <path d="M0,165 Q220,160 400,110 T800,55 L800,180 L0,180 Z" fill="url(#chartGradient2)" />
              <!-- Motion Stroke Line 2 -->
              <path d="M0,165 Q220,160 400,110 T800,55" fill="none" stroke="#ff0080" stroke-width="2.5" />

              <!-- Pulsing Data Nodes -->
              <circle cx="350" cy="70" r="5" fill="#50e3c2" class="animate-ping" />
              <circle cx="350" cy="70" r="5" fill="#50e3c2" />

              <circle cx="800" cy="20" r="6" fill="#00dfd8" />
              <circle cx="800" cy="55" r="5" fill="#ff0080" />
            </svg>
          </div>
        </div>

      </div>

      <!-- Floating Glassmorphic Badges -->
      <div class="hidden lg:flex absolute -top-6 -left-8 glass-badge p-3.5 rounded-[12px] items-center gap-3 animate-float-slow z-20">
        <div class="w-8 h-8 rounded-full bg-[#50e3c2]/20 flex items-center justify-center text-[#29bc9b]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline><polyline points="17 6 23 6 23 12"></polyline></svg>
        </div>
        <div>
          <div class="text-[13px] font-semibold text-[#171717]">+340% Organic Impressions</div>
          <div class="text-[11px] font-mono text-[#888888]">Voice-Matched Ghostwriting</div>
        </div>
      </div>

      <div class="hidden lg:flex absolute -bottom-6 -right-8 glass-badge p-3.5 rounded-[12px] items-center gap-3 animate-float-delayed z-20">
        <div class="w-8 h-8 rounded-full bg-[#7928ca]/20 flex items-center justify-center text-[#7928ca]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
        </div>
        <div>
          <div class="text-[13px] font-semibold text-[#171717]">91% Warm Lead Conversion</div>
          <div class="text-[11px] font-mono text-[#888888]">Sequenced DM Outreach</div>
        </div>
      </div>

    </div>
  </div>
</section>


<!-- ═══════════════════════════════════════════
     MOTION METRICS & ANIMATED CHARTS SECTION
═══════════════════════════════════════════ -->
<section id="metrics" class="bg-[#fafafa] border-y border-[#ebebeb] px-6 py-20 md:py-28">
  <div class="max-w-[1400px] mx-auto">
    
    <!-- Section Header -->
    <div class="text-center max-w-[680px] mx-auto mb-16 reveal-on-scroll">
      <div class="font-mono text-[12px] text-[#888888] uppercase tracking-widest mb-3">Data & Benchmarks</div>
      <h2 class="text-[#171717] font-semibold text-[32px] md:text-[42px] leading-[1.12] tracking-[-1.5px]">
        Metric Motion Charts: Proof Behind Every Strategy
      </h2>
      <p class="text-[#4d4d4d] text-[16px] md:text-[17px] mt-3">
        Every claim in our growth framework is backed by platform research and verified B2B performance analytics.
      </p>
    </div>

    <!-- 3 Interactive Motion Metric Cards -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

      <!-- Motion Metric 1: Decision Maker Density Radial Chart -->
      <div class="bg-[#ffffff] rounded-[16px] p-7 border border-[#ebebeb] card-elevation-2 flex flex-col justify-between reveal-on-scroll hover:border-[#a1a1a1] transition-all">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="font-mono text-[11px] text-[#888888] uppercase tracking-wider">Audience Quality</span>
            <span class="px-2.5 py-0.5 rounded-full bg-[#fafafa] border border-[#ebebeb] text-[#171717] font-mono text-[11px]">Source: LinkedIn Data</span>
          </div>
          <h3 class="text-[#171717] font-semibold text-[20px] tracking-tight mb-2">
            Decision-Maker Density (~80%)
          </h3>
          <p class="text-[#4d4d4d] text-[14px] leading-[1.6] mb-6">
            Roughly 4 out of 5 LinkedIn members influence business decisions, spanning C-suite executives, business owners, and buying committee members.
          </p>
        </div>

        <!-- Radial Donut SVG Motion Visual -->
        <div class="relative flex items-center justify-center my-4">
          <svg class="w-44 h-44 transform -rotate-90" viewBox="0 0 120 120">
            <circle cx="60" cy="60" r="50" fill="none" stroke="#f5f5f5" stroke-width="10" />
            <circle
              id="radial-circle-1"
              cx="60" cy="60" r="50"
              fill="none"
              stroke="url(#radialGradient)"
              stroke-width="10"
              stroke-linecap="round"
              stroke-dasharray="314.15"
              stroke-dashoffset="62.8"
              class="radial-chart-circle"
            />
            <defs>
              <linearGradient id="radialGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#007cf0" />
                <stop offset="100%" stop-color="#50e3c2" />
              </linearGradient>
            </defs>
          </svg>
          <div class="absolute text-center">
            <span class="text-[#171717] font-semibold text-[34px] tracking-tight stat-number" data-target="80">0</span><span class="text-[#0070f3] font-semibold text-[28px]">%</span>
            <div class="text-[11px] font-mono text-[#888888]">Decision Makers</div>
          </div>
        </div>

        <div class="pt-4 border-t border-[#ebebeb] text-center">
          <span class="text-[13px] text-[#4d4d4d]">High-intent buyer concentration</span>
        </div>
      </div>

      <!-- Motion Metric 2: Format Benchmark Motion Bar Chart -->
      <div class="bg-[#ffffff] rounded-[16px] p-7 border border-[#ebebeb] card-elevation-2 flex flex-col justify-between reveal-on-scroll hover:border-[#a1a1a1] transition-all">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="font-mono text-[11px] text-[#888888] uppercase tracking-wider">Format Benchmark</span>
            <span class="px-2.5 py-0.5 rounded-full bg-[#fafafa] border border-[#ebebeb] text-[#171717] font-mono text-[11px]">2026 Analysis</span>
          </div>
          <h3 class="text-[#171717] font-semibold text-[20px] tracking-tight mb-2">
            Carousel Surge (6.6% Engagement)
          </h3>
          <p class="text-[#4d4d4d] text-[14px] leading-[1.6] mb-6">
            Carousels generate the highest average engagement of any LinkedIn format due to multi-slide dwell time and swipe interactions.
          </p>
        </div>

        <!-- Animated Comparison Bar Chart -->
        <div class="space-y-4 my-2">
          
          <div>
            <div class="flex justify-between text-[13px] font-medium mb-1">
              <span class="text-[#171717] font-semibold flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-[#7928ca]"></span> Carousel Post
              </span>
              <span class="font-mono text-[#7928ca] font-semibold">6.6%</span>
            </div>
            <div class="w-full bg-[#f5f5f5] h-3 rounded-full overflow-hidden">
              <div class="bg-gradient-to-r from-[#7928ca] to-[#ff0080] h-full rounded-full chart-bar-fill" style="width: 100%;"></div>
            </div>
          </div>

          <div>
            <div class="flex justify-between text-[13px] font-medium mb-1">
              <span class="text-[#4d4d4d] flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-[#0070f3]"></span> Single Image Post
              </span>
              <span class="font-mono text-[#888888]">3.2%</span>
            </div>
            <div class="w-full bg-[#f5f5f5] h-3 rounded-full overflow-hidden">
              <div class="bg-[#0070f3] h-full rounded-full chart-bar-fill" style="width: 48%;"></div>
            </div>
