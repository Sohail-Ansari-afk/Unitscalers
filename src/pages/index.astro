<!-- ═══════════════════════════════════════════
     INTERACTION & SCROLL ANIMATION CLIENT SCRIPT
═══════════════════════════════════════════ -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Intersection Observer for Scroll Reveals
    const observerOptions = {
      threshold: 0.15,
      rootMargin: '0px 0px -50px 0px'
    };

    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-revealed');
          
          // Trigger animated counters inside revealed elements
          const counters = entry.target.querySelectorAll('.stat-number');
          counters.forEach(counter => {
            const target = parseFloat(counter.getAttribute('data-target'));
            if (target && !counter.classList.contains('counted')) {
              counter.classList.add('counted');
              let count = 0;
              const duration = 1200;
              const increment = target / (duration / 16);
              const timer = setInterval(() => {
                count += increment;
                if (count >= target) {
                  counter.textContent = target;
                  clearInterval(timer);
                } else {
                  counter.textContent = Math.floor(count);
                }
              }, 16);
            }
          });

          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.querySelectorAll('.reveal-on-scroll').forEach(el => revealObserver.observe(el));

    // 2. Interactive Reach Multiplier Calculator logic
    const sliderPosts = document.getElementById('slider-posts');
    const sliderNetwork = document.getElementById('slider-network');
    const valPosts = document.getElementById('slider-posts-val');
    const valNetwork = document.getElementById('slider-[#171717]work-val');
    const outReach = document.getElementById('calc-reach-val');
    const outProfile = document.getElementById('calc-profile-impressions');
    const outCompany = document.getElementById('calc-company-impressions');
    const outDms = document.getElementById('calc-pipeline-dms');

    function updateCalculator() {
      if (!sliderPosts || !sliderNetwork) return;
      const posts = parseInt(sliderPosts.value);
      const network = parseInt(sliderNetwork.value);

      if (valPosts) valPosts.textContent = `${posts} posts/mo`;
      if (valNetwork) valNetwork.textContent = `${network.toLocaleString()} connections`;

      // Algorithm: Personal Profile gets ~3.5x multiplier on reach per post vs company page
      const baseCompanyReachPerPost = Math.round(network * 0.25);
      const companyTotalMonthly = baseCompanyReachPerPost * posts;
      const profileTotalMonthly = Math.round(companyTotalMonthly * 3.5);

      const minDms = Math.max(4, Math.round(profileTotalMonthly * 0.0005));
      const maxDms = Math.max(8, Math.round(profileTotalMonthly * 0.0009));

      if (outReach) outReach.textContent = profileTotalMonthly.toLocaleString();
      if (outProfile) outProfile.textContent = profileTotalMonthly.toLocaleString();
      if (outCompany) outCompany.textContent = companyTotalMonthly.toLocaleString();
      if (outDms) outDms.textContent = `${minDms} - ${maxDms} / mo`;
    }

    if (sliderPosts && sliderNetwork) {
      sliderPosts.addEventListener('input', updateCalculator);
      sliderNetwork.addEventListener('input', updateCalculator);
      updateCalculator();
    }

    // 3. Modal Dialog & Audit Form Submission logic (unitscalers@gmail.com)
    const modal = document.getElementById('audit-modal');
    const closeModalBtn = document.getElementById('close-modal-btn');

    function openModal(e) {
      if (e) e.preventDefault();
      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeModal() {
      if (modal) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
      }
    }

    // Bind all "Book a Free Audit" CTA buttons to open modal
    const auditCtaSelectors = [
      '#nav-cta-audit',
      '#hero-cta-primary',
      '#pricing-content-cta',
      '#pricing-growth-cta',
      '#pricing-pipeline-cta',
      'a[href="#contact"]'
    ];

    document.querySelectorAll(auditCtaSelectors.join(',')).forEach(btn => {
      // If clicking a link pointing to #contact, open modal unless it's scrolled smoothly
      btn.addEventListener('click', (e) => {
        const href = btn.getAttribute('href');
        if (href === '#contact') {
          const contactSection = document.getElementById('contact');
          if (contactSection) {
            contactSection.scrollIntoView({ behavior: 'smooth' });
            return;
          }
        }
        openModal(e);
      });
    });

    if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }

    // Generic AJAX Form Handler sending to unitscalers@gmail.com via FormSubmit
    async function handleFormSubmit(formEl, statusEl, submitBtn) {
      formEl.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const originalBtnHtml = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = `
          <svg class="animate-spin w-4 h-4 text-[#171717]" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span>Sending request...</span>
        `;

        statusEl.classList.add('hidden');

        const formData = new FormData(formEl);
        const data = {
          name: formData.get('name'),
          email: formData.get('email'),
          linkedin: formData.get('linkedin') || 'Not provided',
          _subject: `New Free Audit Request from ${formData.get('name')}`
        };

        try {
          const response = await fetch('https://formspree.io/f/xnjegbok', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify(data)
          });

          if (response.ok) {
            statusEl.className = 'block bg-[#29bc9b]/20 text-[#29bc9b] border border-[#29bc9b]/30 p-3 rounded-[10px] text-[13px] font-mono text-center mt-3';
            statusEl.textContent = '✓ Audit requested successfully! We will email you within 24 hours.';
            formEl.reset();
            setTimeout(() => {
              if (modal && !modal.classList.contains('hidden')) {
                closeModal();
              }
            }, 3000);
          } else {
            throw new Error('Form submission failed');
          }
        } catch (err) {
          statusEl.className = 'block bg-red-500/20 text-red-300 border border-red-500/30 p-3 rounded-[10px] text-[13px] font-mono text-center mt-3';
          statusEl.textContent = '❌ Unable to send request. Please email us directly at unitscalers@gmail.com';
        } finally {
          submitBtn.disabled = false;
          submitBtn.innerHTML = originalBtnHtml;
        }
      });
    }

    const inlineForm = document.getElementById('inline-audit-form');
    const inlineStatus = document.getElementById('inline-form-status');
    const inlineBtn = document.getElementById('inline-submit-btn');

    const modalForm = document.getElementById('modal-audit-form');
    const modalStatus = document.getElementById('modal-form-status');
    const modalBtn = document.getElementById('modal-submit-btn');

    if (inlineForm && inlineStatus && inlineBtn) {
      handleFormSubmit(inlineForm, inlineStatus, inlineBtn);
    }
    if (modalForm && modalStatus && modalBtn) {
      handleFormSubmit(modalForm, modalStatus, modalBtn);
    }
  });
</script>

