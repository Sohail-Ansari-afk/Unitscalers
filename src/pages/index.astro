      const counter1 = document.getElementById('mg-counter-1');
      if (arc) {
        // stroke-dasharray="301.6 75.4" starts dashoffset=301.6 (hidden), animate to 0 (full 80%)
        arc.style.strokeDashoffset = '0';
      }
      if (counter1) {
        let start = 0;
        const end = 80;
        const duration = 1800;
        const startTime = performance.now();
        function tick(now) {
          const elapsed = now - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          counter1.textContent = Math.round(eased * end);
          if (progress < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      }

      // Panel 2: Bars
      setTimeout(() => {
        const barProfile = document.getElementById('mg-bar-profile');
        const barCompany = document.getElementById('mg-bar-company');
        const rangeBar = document.getElementById('mg-range-bar');
        if (barProfile) barProfile.style.width = '100%';
        if (barCompany) barCompany.style.width = '20%';
        if (rangeBar) rangeBar.style.width = '100%';
      }, 200);

      // Panel 3: Flow steps stagger in
      const steps = document.querySelectorAll('.mg-flow-step');
      const arrows = document.querySelectorAll('.mg-arrow');
      steps.forEach((el, i) => {
        setTimeout(() => {
          (el as HTMLElement).style.opacity = '1';
          (el as HTMLElement).style.transform = 'translateX(0)';
        }, 300 + i * 220);
      });
      arrows.forEach((el, i) => {
        setTimeout(() => {
          (el as HTMLElement).style.opacity = '1';
        }, 400 + i * 220);
      });
    }

    // IntersectionObserver to trigger when section scrolls into view
    const target = document.getElementById('macroshift-motion');
    if (target && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            animateMacroshift();
            observer.disconnect();
          }
        });
      }, { threshold: 0.15 });
      observer.observe(target);
    } else if (target) {
      animateMacroshift();
    }
  })();
</script>


