---
import Layout from '../../layouts/Layout.astro';

const posts = [
  {
    slug: "best-seo-agency-shopify-skincare",
    number: "01",
    tag: "Shopify SEO",
    title: "Best SEO Agency for Shopify Skincare Stores: A Founder's Checklist",
    excerpt: "What separates a good Shopify SEO agency from a generic one — a practical checklist for D2C skincare founders, with real pricing benchmarks and red flags to avoid.",
    readTime: "6 min read",
    primaryKeyword: "best seo agency for shopify stores",
    category: "Comparison / Evaluation",
  },
  {
    slug: "hidden-shopify-seo-problems-skincare",
    number: "02",
    tag: "Technical SEO",
    title: "The Hidden Shopify SEO Problems Costing Skincare Brands Rankings",
    excerpt: "Shopify creates duplicate content and speed problems automatically. Here's the technical audit data every skincare brand owner should see before hiring an SEO agency.",
    readTime: "5 min read",
    primaryKeyword: "shopify seo agency for skincare brands",
    category: "Technical Authority",
  },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Unitscalers Blog",
  "description": "In-depth guides on Shopify SEO, skincare brand marketing, and D2C growth strategy — written for founders who are evaluating their next move.",
  "url": "https://unitscalers.com/blog",
  "publisher": {
    "@type": "Organization",
    "name": "Unitscalers"
  }
};
---

<Layout
  title="Blog | Unitscalers — Shopify SEO & Skincare Marketing Insights"
  description="In-depth guides on Shopify SEO, skincare brand marketing, and D2C growth strategy — written for founders who are evaluating their next move."
  schema={schema}
>
  <!-- Hero -->
  <section class="border-b border-gray-200 dark:border-gray-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 md:px-12 py-16 md:py-28 text-center">
      <div class="font-mono text-xs uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-5">From the Unitscalers team</div>
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight mb-6 leading-tight text-brand-dark dark:text-white">
        Shopify SEO & Skincare Marketing — No Fluff
      </h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed max-w-2xl mx-auto">
        In-depth guides written for D2C skincare founders evaluating agencies, pricing, and strategy.
        Every number is sourced. Nothing is invented.
      </p>
    </div>
  </section>

  <!-- Blog Posts Grid -->
  <section class="py-20 md:py-28 bg-gray-50 dark:bg-gray-900">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 md:px-12">
      <!-- Cluster label -->
      <div class="flex items-center gap-3 mb-12">
        <div class="h-px flex-1 bg-gray-200 dark:bg-gray-800"></div>
        <span class="font-mono text-xs uppercase tracking-widest text-gray-400 dark:text-gray-500 whitespace-nowrap">Mid-Funnel SEO Series</span>
        <div class="h-px flex-1 bg-gray-200 dark:bg-gray-800"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        {posts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="group block border border-gray-200 dark:border-gray-800 bg-white dark:bg-black hover:border-brand-dark dark:hover:border-gray-400 transition-all duration-200 hover:shadow-lg hover:-translate-y-0.5"
          >
            <!-- Card top bar -->
            <div class="bg-brand-dark dark:bg-gray-900 px-6 py-3 flex items-center justify-between border-b border-gray-800">
              <span class="font-mono text-[10px] uppercase tracking-widest text-gray-400">{post.category}</span>
              <span class="font-mono text-[10px] uppercase tracking-widest text-brand-green">{post.tag}</span>
            </div>

            <!-- Card body -->
            <div class="p-6 md:p-8 flex flex-col h-full">
              <div class="font-mono text-5xl font-bold text-gray-100 dark:text-gray-800 mb-4 leading-none select-none">
                {post.number}
              </div>
              <h2 class="text-xl md:text-2xl font-bold tracking-tight text-brand-dark dark:text-white mb-4 leading-snug group-hover:underline underline-offset-2">
                {post.title}
              </h2>
              <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed mb-8 flex-1">
                {post.excerpt}
              </p>
              <div class="flex items-center justify-between">
                <span class="text-xs text-gray-400 dark:text-gray-600 font-mono">{post.readTime}</span>
                <span class="font-mono text-xs uppercase tracking-widest text-brand-dark dark:text-white flex items-center gap-1 group-hover:gap-2 transition-all duration-150">
                  Read article
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Series note -->
      <div class="mt-16 p-6 border border-gray-200 dark:border-gray-800 bg-white dark:bg-black">
        <p class="text-sm text-gray-500 dark:text-gray-500 leading-relaxed">
          <span class="font-mono text-xs uppercase tracking-widest text-gray-400 dark:text-gray-600 block mb-2">About this series</span>
          These articles are part of a five-article cluster built around the evaluation questions D2C skincare founders ask before hiring an SEO agency.
          Every statistic is sourced from third-party 2026 industry research — none is Unitscalers' own client data.
          More articles coming soon.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-brand-dark dark:bg-gray-900 text-white border-t border-gray-800">
    <div class="max-w-3xl mx-auto px-6 md:px-12 text-center">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-6">Ready to audit your Shopify SEO?</h2>
      <p class="text-gray-400 mb-10 leading-relaxed">
        We start with a free technical audit — no templates, no generic advice. Just an honest look at what your store's architecture and rankings actually show.
      </p>
      <a
        href="/contact-us"
        class="inline-flex font-mono text-xs uppercase tracking-widest bg-white text-brand-dark px-8 py-4 hover:bg-gray-100 transition-colors"
      >
        Book a Free Audit
      </a>
    </div>
  </section>
</Layout>
