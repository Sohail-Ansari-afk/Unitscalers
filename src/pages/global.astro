<script>
  // Progress bars
  const bars = document.querySelectorAll('.progress-bar');
  const barObs = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const bar = entry.target as HTMLElement;
        bar.style.animation = 'progress-fill 1.5s cubic-bezier(0.4,0,0.2,1) forwards';
        barObs.unobserve(bar);
      }
    });
  }, { threshold: 0.3 });
  bars.forEach(b => barObs.observe(b));

  // MER bars
  const merBars = document.querySelectorAll('.global-mer-bar');
  const merObs = new IntersectionObserver(entries => {
    if (entries[0].isIntersecting) {
      merBars.forEach(bar => {
        const el = bar as HTMLElement;
        setTimeout(() => { el.style.width = el.dataset.width + '%'; }, 300);
      });
      merObs.disconnect();
    }
  }, { threshold: 0.4 });
  if (merBars[0]) merObs.observe(merBars[0]);

  // Stagger fade-in for cards
  ['global-leak-card', 'global-pillar-card', 'global-step-card', 'global-pricing-card', 'global-faq-item'].forEach(cls => {
    const els = document.querySelectorAll('.' + cls);
    const obs = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const idx = parseInt(el.dataset.index || '0');
          setTimeout(() => {
            el.style.opacity = '1';
            el.style.transform = 'translateY(0)';
          }, idx * 80);
          obs.unobserve(el);
        }
      });
    }, { threshold: 0.08 });
    els.forEach(el => {
      (el as HTMLElement).style.opacity = '0';
      (el as HTMLElement).style.transform = 'translateY(18px)';
      (el as HTMLElement).style.transition = 'opacity 0.5s ease, transform 0.5s ease';
      obs.observe(el);
    });
  });

  // FAQ accordion
  document.querySelectorAll('.global-faq-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll('.global-faq-btn').forEach(b => {
        b.setAttribute('aria-expanded', 'false');
        const p = document.getElementById(b.getAttribute('aria-controls')!);
        p?.classList.add('hidden');
        const ic = b.querySelector('.global-faq-icon') as SVGElement;
        if (ic) ic.style.transform = 'rotate(0deg)';
      });
      if (!expanded) {
        btn.setAttribute('aria-expanded', 'true');
        const panel = document.getElementById(btn.getAttribute('aria-controls')!);
        panel?.classList.remove('hidden');
        const icon = btn.querySelector('.global-faq-icon') as SVGElement;
        if (icon) icon.style.transform = 'rotate(180deg)';
      }
    });
  });

  // ── Audit form — Web3Forms submission ────────────────────────────────────
  const auditForm = document.getElementById('global-audit-form') as HTMLFormElement | null;
  auditForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const btn      = document.getElementById('global-audit-btn') as HTMLButtonElement;
    const btnText  = document.getElementById('global-audit-btn-text')!;
    const spinner  = document.getElementById('global-audit-spinner')!;
    const success  = document.getElementById('global-audit-success')!;
    const error    = document.getElementById('global-audit-error')!;

    // Loading state
    btn.disabled = true;
    btnText.textContent = 'Sending...';
    spinner.classList.remove('hidden');
    success.classList.add('hidden');
    error.classList.add('hidden');

    try {
      const formData = new FormData(auditForm);
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData,
      });
      const data = await res.json();

      if (data.success) {
        // Success state
        success.classList.remove('hidden');
        auditForm.reset();
      } else {
        throw new Error(data.message || 'Submission failed');
      }
    } catch (err) {
      // Error state
      error.classList.remove('hidden');
      console.error('Audit form error:', err);
    } finally {
      // Reset button
      btn.disabled = false;
      btnText.textContent = 'Get Free Audit';
      spinner.classList.add('hidden');
    }
  });
</script>
