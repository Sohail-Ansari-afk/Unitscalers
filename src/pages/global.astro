---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';

const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
---

<Layout
  title="UnitScalers — Stop Renting Casual Traffic. Build a High-Yield Profit Engine."
  description="A data-driven media buying agency for global Shopify brands scaling $20K-$150K/month. We eliminate vanity platform metrics and engineer predictable net profit across global markets."
>
  <!-- JSON-LD Schema for International -->
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "UnitScalers",
    "description": "A data driven media buying agency for shopify brands specializing in omnichannel profit engineering and customer acquisition cost reduction.",
    "url": "https://unitscalers.com/global",
    "priceRange": "$$$",
    "knowsAbout": [
      "Performance Marketing",
      "E-commerce Growth",
      "Customer Acquisition Cost Optimization",
      "Omnichannel Ad Strategy",
      "First-Party Data Attribution"
    ]
  }
  </script>

  <Navbar />

  <main>

    <!-- HERO BAND -->
    <section id="global-hero" class="relative min-h-screen flex flex-col items-center justify-center overflow-hidden bg-white pt-16">
      <!-- Mesh gradient backdrop -->
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background: radial-gradient(ellipse 90% 70% at 50% -10%, rgba(0,124,240,0.18) 0%, transparent 58%), radial-gradient(ellipse 70% 60% at 90% 10%, rgba(0,223,216,0.13) 0%, transparent 55%), radial-gradient(ellipse 60% 50% at 10% 20%, rgba(121,40,202,0.12) 0%, transparent 55%), radial-gradient(ellipse 80% 65% at 50% 90%, rgba(249,203,40,0.08) 0%, transparent 55%); animation: mesh-drift 14s ease-in-out infinite;"></div>
      <!-- Dot grid -->
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background-image: radial-gradient(circle, #d4d4d4 1px, transparent 1px); background-size: 32px 32px; opacity: 0.28;"></div>

      <div class="relative z-10 max-w-[1100px] mx-auto px-6 py-20 text-center">

        <!-- Announcement badge -->
        <a href="#global-audit" class="inline-flex items-center gap-2 bg-[#fafafa] border border-[#ebebeb] rounded-full px-4 py-1.5 mb-8 text-[13px] text-[#4d4d4d] hover:border-[#a1a1a1] transition-colors" style="box-shadow: inset 0 0 0 1px rgba(0,0,0,0.04);">
          <span class="w-2 h-2 rounded-full bg-[#50e3c2] flex-shrink-0" style="animation: pulse-ring 2s ease-in-out infinite;"></span>
          <span class="text-[11px] font-mono uppercase tracking-wider text-[#888]">Global offer</span>
          <span>Free profit leak audit -- 3 fixes, specific to your Shopify store.</span>
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6h8M7 3l3 3-3 3" stroke="#888" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>

        <!-- Main Headline -->
        <h1 class="text-[52px] md:text-[68px] lg:text-[80px] font-semibold text-[#171717] leading-[1.02] tracking-[-3.5px] mb-6 max-w-4xl mx-auto">
          Stop renting casual<br class="hidden sm:block"/> traffic.<br/>
          <span style="background: linear-gradient(90deg, #007cf0 0%, #00dfd8 30%, #7928ca 65%, #ff0080 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Build a high-yield profit engine.</span>
        </h1>

        <!-- Sub-headline -->
        <p class="text-[18px] md:text-[20px] text-[#4d4d4d] leading-[30px] max-w-2xl mx-auto mb-10">
          We are a specialized data-driven media buying agency for Shopify brands scaling from <strong class="text-[#171717] font-medium">$20K to $150K</strong> in monthly revenue -- eliminating vanity platform metrics and engineering predictable net profit across global markets.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-20">
          <a href="#global-audit" id="global-hero-cta" class="h-12 px-8 rounded-full bg-[#171717] text-white text-[16px] font-medium flex items-center gap-2 hover:bg-[#333] transition-all duration-200 hover:scale-[1.02] shadow-lg shadow-black/10">
            Claim Your Free 5-Min Account Audit
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="#global-solutions" id="global-hero-secondary" class="h-12 px-8 rounded-full bg-white text-[#171717] text-[16px] font-medium flex items-center gap-2 border border-[#ebebeb] hover:bg-[#fafafa] transition-all duration-200" style="box-shadow: inset 0 0 0 1px rgba(0,0,0,0.06), 0 1px 3px rgba(0,0,0,0.04);">
            See How We Work
          </a>
        </div>

        <!-- Proof metrics strip -->
        <div class="flex flex-wrap items-center justify-center gap-px bg-[#ebebeb] rounded-2xl overflow-hidden border border-[#ebebeb]" style="box-shadow: inset 0 0 0 1px rgba(0,0,0,0.06), 0 2px 8px rgba(0,0,0,0.04);">
          {[
            { value: "$150K+", label: "Avg. revenue scaled / month", color: "#007cf0" },
            { value: "38%",    label: "Avg. CAC reduction in 90 days", color: "#7928ca" },
            { value: "4.2x",   label: "Avg. MER across global portfolio", color: "#00dfd8" },
            { value: "30+",    label: "Shopify brands across 12 countries", color: "#f9cb28" },
          ].map(m => (
            <div class="flex-1 min-w-[140px] bg-white px-6 py-5 text-center">
              <div class="text-[28px] font-semibold leading-none mb-1" style={`color: ${m.color}`}>{m.value}</div>
              <div class="text-[12px] text-[#888] leading-[16px]">{m.label}</div>
            </div>
          ))}
        </div>

        <p class="text-[12px] text-[#888] mt-4 font-mono">No generic advice. Just 3 immediate bottlenecks fixed -- free.</p>

        <!-- Region flags strip -->
        <div class="flex flex-wrap items-center justify-center gap-2 mt-5">
          <span class="text-[11px] text-[#888] font-mono">Serving brands in:</span>
          {["US USA", "UK UK", "AU Australia", "CA Canada", "DE Germany", "AE UAE", "SG Singapore", "ZA South Africa"].map(flag => (
            <span class="text-[12px] text-[#4d4d4d] bg-[#fafafa] border border-[#ebebeb] rounded-full px-2.5 py-0.5">{flag}</span>
          ))}
        </div>
      </div>

      <a href="#global-reality" class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1.5 text-[#888] animate-bounce" aria-label="Scroll down">
        <span class="text-[11px] font-mono uppercase tracking-wider">Scroll</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 3v10M4 9l4 4 4-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </section>

    <!-- THE 2026 REALITY -->
    <section id="global-reality" class="bg-[#fafafa] border-t border-[#ebebeb] py-24">
      <div class="max-w-[1200px] mx-auto px-6">
        <div class="max-w-3xl mb-16">
          <span class="text-[11px] font-mono uppercase tracking-[0.12em] text-[#888] mb-4 block">The 2026 e-commerce reality</span>
          <h2 class="text-[32px] font-semibold text-[#171717] tracking-[-1.28px] leading-[40px] mb-6">
            Profitability over vanity numbers.
          </h2>
          <p class="text-[17px] text-[#4d4d4d] leading-[28px]">
            Shopify's global merchant data highlights that finding high-value customers remains the absolute top challenge for scaling store owners. Paid advertising is still the single highest-leverage growth engine for high-revenue brands -- but the old way of buying ads is dead.
          </p>
        </div>

        <!-- Revenue breakdown card -->
        <div class="bg-white rounded-xl border border-[#ebebeb] p-8 mb-6" style="box-shadow: inset 0 0 0 1px rgba(0,0,0,0.04), 0 2px 8px rgba(0,0,0,0.04);">
          <div class="flex flex-col lg:flex-row gap-10">
            <div class="lg:w-72 flex-shrink-0">
              <span class="text-[11px] font-mono uppercase tracking-wider text-[#888] mb-3 block">The hard truth</span>
              <h3 class="text-[22px] font-semibold text-[#171717] tracking-[-0.96px] leading-[30px] mb-4">Where your $100K GMV actually goes.</h3>
              <p class="text-[14px] text-[#4d4d4d] leading-[22px]">A typical global DTC brand at $100K/month GMV keeps far less than expected once you account for all acquisition costs. Many agencies celebrate ROAS while your cash flow stagnates -- a structural margin leak, not a traffic problem.</p>
            </div>
            <div class="flex-1 space-y-4">
              {[
                { label: "Gross Revenue (GMV)", value: 100, display: "$100K", color: "#007cf0" },
                { label: "Ad Spend (Meta + Google avg. 30%)", value: 30, display: "$30K", color: "#ee0000" },
                { label: "Fulfillment + COGS (avg. 35%)", value: 35, display: "$35K", color: "#f5a623" },
                { label: "Chargebacks + Returns (avg. 8%)", value: 8, display: "$8K", color: "#7928ca" },
                { label: "Net Contribution Margin", value: 27, display: "$27K -- What actually hits the bank", color: "#50e3c2" },
              ].map((row, i) => (
                <div class="global-bar-row" data-index={i}>
                  <div class="flex items-center justify-between mb-1.5">
                    <span class="text-[13px] font-medium text-[#171717]">{row.label}</span>
                    <span class="text-[12px] font-mono text-[#4d4d4d]">{row.display}</span>
                  </div>
                  <div class="h-2.5 bg-[#f5f5f5] rounded-full overflow-hidden">
                    <div class="h-full rounded-full progress-bar" style={`background: ${row.color}; --target-width: ${row.value}%; width: 0%;`}></div>
                  </div>
                </div>
              ))}
              <p class="text-[12px] text-[#888] font-mono">* Average across 30+ global Shopify brands in our portfolio</p>
            </div>
          </div>
        </div>

        <!-- 3 structural problems -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
          {[
            {
              icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M11 2l2.83 5.74L20 8.73l-4.5 4.39 1.06 6.2L11 16.3l-5.56 2.93L6.5 13 2 8.73l6.17-.99L11 2z" stroke="#ee0000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
              color: "#ee0000",
              num: "Problem 01",
              title: "Platform ROAS is a lie.",
              body: "Meta and Google both claim credit for the same sales. Cross-channel attribution overlap can inflate your reported ROAS by 40-80%. You're making scaling decisions on corrupted data.",
              stat: "~60% of reported ROAS is attributed twice",
            },
            {
              icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M15.5 19v-2a4 4 0 00-4-4H4a4 4 0 00-4 4v2M8 11a4 4 0 100-8 4 4 0 000 8zM22 19v-2a4 4 0 00-3-3.87M15 3.13a4 4 0 010 7.75" stroke="#f5a623" stroke-width="1.5" stroke-linecap="round"/></svg>`,
              color: "#f5a623",
              num: "Problem 02",
              title: "Wrong-fit audience scaling.",
              body: "Scaling to lookalike audiences without segmenting by LTV means acquiring low-repeat-purchase customers at premium CAC. High ad spend, low lifetime value -- a slow bleed.",
              stat: "Avg. repeat purchase rate: 18% (should be 35%+)",
            },
            {
              icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none"><rect x="2" y="2" width="18" height="18" rx="4" stroke="#7928ca" stroke-width="1.5"/><path d="M7 11h8M11 7v8" stroke="#7928ca" stroke-width="1.5" stroke-linecap="round"/></svg>`,
              color: "#7928ca",
              num: "Problem 03",
              title: "No creative testing system.",
              body: "Most brands run 2-3 ad creatives for weeks until performance collapses. Without a structured weekly creative testing pipeline, CPMs spike 40-60% within a month of campaign launch.",
              stat: "Creative fatigue costs brands 31% extra in ad spend",
            },
          ].map((card, i) => (
            <div class="global-leak-card bg-white rounded-xl border border-[#ebebeb] p-6 hover:-translate-y-0.5 transition-all duration-200" data-index={i} style="box-shadow: inset 0 0 0 1px rgba(0,0,0,0.04), 0 2px 8px rgba(0,0,0,0.04);">
              <div class="flex items-start justify-between mb-4">
                <div class="w-10 h-10 rounded-lg flex items-center justify-center" style={`background: ${card.color}15`}>
                  <Fragment set:html={card.icon} />
                </div>
                <span class="text-[11px] font-mono text-[#888] bg-[#fafafa] border border-[#ebebeb] rounded-full px-2 py-0.5">{card.num}</span>
              </div>
              <h3 class="text-[17px] font-semibold text-[#171717] tracking-[-0.4px] leading-[24px] mb-2">{card.title}</h3>
              <p class="text-[13px] text-[#4d4d4d] leading-[20px] mb-4">{card.body}</p>
              <div class="text-[12px] font-mono" style={`color: ${card.color}`}>{card.stat}</div>
            </div>
          ))}
        </div>

        <!-- Dark impact band -->
        <div class="bg-[#171717] rounded-xl p-8 text-white" style="box-shadow: 0 2px 8px rgba(0,0,0,0.12), 0 8px 32px rgba(0,0,0,0.08);">
          <div class="flex flex-col md:flex-row items-center justify-between gap-8">
            <div class="md:max-w-sm">
              <span class="text-[11px] font-mono uppercase tracking-wider text-[#888] mb-2 block">Our positioning</span>
              <h3 class="text-[22px] font-semibold text-white tracking-[-0.96px] leading-[30px] mb-3">We act as your fractional growth marketer for e-commerce brands.</h3>
              <p class="text-[14px] text-[#888] leading-[22px]">According to EMARKETER's latest D2C market guidance, sustainable brands must abandon isolated acquisition silos. We align every dollar of ad spend directly with your P&amp;L -- not a dashboard metric.</p>
            </div>
            <div class="flex-1 grid grid-cols-2 gap-4">
              {[
                { value: "38%", label: "CAC Reduction", color: "#007cf0" },
                { value: "4.2x", label: "True MER", color: "#50e3c2" },
                { value: "2.8x", label: "Repeat Purchase Rate", color: "#7928ca" },
                { value: "5x", label: "Weekly Creative Output", color: "#f9cb28" },
              ].map(s => (
                <div class="text-center bg-[#1a1a1a] rounded-xl p-4 border border-[#2a2a2a]">
                  <div class="text-[32px] font-semibold tracking-[-1.5px] leading-none mb-1" style={`color: ${s.color}`}>{s.value}</div>
                  <div class="text-[12px] text-[#888]">{s.label}</div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CORE SOLUTION PILLARS -->
    <section id="global-solutions" class="bg-white py-24 border-t border-[#ebebeb]">
      <div class="max-w-[1200px] mx-auto px-6">
        <div class="text-center mb-16">
          <span class="text-[11px] font-mono uppercase tracking-[0.12em] text-[#888] mb-4 block">What we do</span>
          <h2 class="text-[32px] font-semibold text-[#171717] tracking-[-1.28px] leading-[40px] mb-4">
            Engineered for omnichannel acquisition and profitable scale.
          </h2>
          <p class="text-[18px] text-[#4d4d4d] max-w-xl mx-auto leading-[28px]">
            Four integrated systems that work together to reduce CAC, increase LTV, and maximize your real Marketing Efficiency Ratio.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
          {[
            {
              num: "01",
              badge: "Creative",
              title: "High-velocity asset testing.",
              body: "Creative fatigue is the number one cause of sudden performance drops. We deploy a systematic meta ad creative testing framework -- designing, isolating variables, and testing 3-5 unique creative hooks every week to stay ahead of rising CPMs.",
              details: ["5+ new concepts designed weekly", "Variable isolation & hook-rate analysis", "Localized creative per market", "Weekly creative performance autopsy"],
              color: "#007cf0",
            },
            {
              num: "02",
              badge: "Acquisition",
              title: "Omnichannel demand capture.",
              body: "Relying on a single channel exposes your brand to platform volatility. We capture demand across the entire digital ecosystem -- each channel with a dedicated budget tied to its real MER contribution.",
              details: ["Meta (Instagram & Facebook) -- brand discovery", "Google Search & Shopping -- high-intent capture", "TikTok & social -- AI-driven visual discovery", "Cross-channel budget by MER contribution"],
              color: "#7928ca",
            },
            {
              num: "03",
              badge: "Attribution",
              title: "First-party data guardrails.",
              body: "Standard platform attribution is inaccurate due to modern privacy protocols. We bypass broken third-party tracking with server-side CAPI setup and an internal Marketing Efficiency Ratio calculator to evaluate your true ecosystem health.",
              details: ["Meta CAPI + Google Enhanced Conversions", "Custom cross-channel attribution model", "Internal MER calculator dashboard", "P&L-linked decision framework"],
              color: "#00dfd8",
            },
            {
              num: "04",
              badge: "Retention",
              title: "LTV engineering & retention loops.",
              body: "Acquiring a customer once is expensive. We build post-purchase email + SMS sequences, smart product bundling, and subscription conversion flows that compound your LTV -- lowering effective CAC with every repeat order.",
              details: ["Post-purchase email + SMS flows", "Subscription upsell conversion", "LTV cohort tracking dashboard", "Smart product recommendation sequences"],
              color: "#f9cb28",
            },
          ].map((p, i) => (
            <div class="global-pillar-card bg-[#fafafa] rounded-xl border border-[#ebebeb] p-8 hover:border-[#a1a1a1] transition-all duration-200 group" data-index={i}>
              <div class="flex items-center gap-3 mb-5">
                <div class="text-[11px] font-mono font-medium px-2.5 py-1 rounded-md" style={`color: ${p.color}; background: ${p.color}18;`}>{p.num}</div>
                <span class="text-[11px] font-mono text-[#888] bg-white border border-[#ebebeb] rounded-full px-2 py-0.5">{p.badge}</span>
              </div>
              <h3 class="text-[20px] font-semibold text-[#171717] tracking-[-0.6px] leading-[28px] mb-3">{p.title}</h3>
              <p class="text-[14px] text-[#4d4d4d] leading-[22px] mb-5">{p.body}</p>
              <ul class="space-y-2">
                {p.details.map(d => (
                  <li class="flex items-start gap-2.5 text-[13px] text-[#4d4d4d]">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="flex-shrink-0 mt-0.5"><circle cx="7" cy="7" r="6" fill={p.color} fill-opacity="0.12"/><path d="M4.5 7l2 2 3-3" stroke={p.color} stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {d}
                  </li>
                ))}
              </ul>
              <div class="mt-5 h-0.5 w-0 group-hover:w-full rounded-full transition-all duration-500" style={`background: linear-gradient(90deg, ${p.color}, transparent);`}></div>
            </div>
          ))}
        </div>

        <!-- MER formula dark band -->
        <div class="bg-[#171717] rounded-xl p-8 text-white" style="box-shadow: 0 2px 8px rgba(0,0,0,0.12);">
          <div class="flex flex-col lg:flex-row gap-10 items-center">
            <div class="lg:w-80">
              <span class="text-[11px] font-mono uppercase tracking-wider text-[#888] mb-2 block">Our north star</span>
              <h3 class="text-[22px] font-semibold text-white tracking-[-0.96px] leading-[30px] mb-3">We track MER. Not platform ROAS.</h3>
              <p class="text-[14px] text-[#888] leading-[22px]">MER = Total Revenue divided by Total Ad Spend across all paid channels. The only metric that maps directly to your bank account -- not inflated attribution windows. We build and own your MER dashboard from day one.</p>
            </div>
            <div class="flex-1 flex flex-col sm:flex-row items-center gap-8">
              <div class="flex-1 space-y-4 w-full">
                {[
                  { label: "Platform-reported ROAS (inflated)", pct: 87, color: "#ee0000", val: "8.7x" },
                  { label: "Actual blended MER (real)", pct: 42, color: "#50e3c2", val: "4.2x" },
                ].map(row => (
                  <div>
                    <div class="flex justify-between mb-1.5 text-[12px]">
                      <span class="text-[#888]">{row.label}</span>
                      <span class="font-mono" style={`color: ${row.color}`}>{row.val}</span>
                    </div>
                    <div class="h-3 bg-[#2a2a2a] rounded-full overflow-hidden">
                      <div class="h-full rounded-full global-mer-bar" style={`width: 0%; background: ${row.color}; transition: width 1.5s ease;`} data-width={row.pct}></div>
                    </div>
                  </div>
                ))}
              </div>
              <div class="bg-[#1a1a1a] border border-[#333] rounded-xl p-5 font-mono text-center min-w-[160px]" style="box-shadow: inset 0 0 0 1px rgba(255,255,255,0.05);">
                <div class="text-[11px] text-[#555] uppercase tracking-wider mb-3">True MER</div>
                <div class="text-[14px] text-white mb-1">Total Revenue</div>
                <div class="h-px bg-[#444] my-2"></div>
                <div class="text-[14px] text-white mb-3">All Ad Spend</div>
                <div class="text-[28px] font-semibold" style="color: #50e3c2;">4.2x</div>
                <div class="text-[11px] text-[#555] mt-1">global avg.</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW WE WORK (3 PHASES) -->
    <section id="global-how" class="bg-[#171717] py-24 border-t border-[#2a2a2a]">
      <div class="max-w-[1200px] mx-auto px-6">
        <div class="text-center mb-16">
          <span class="text-[11px] font-mono uppercase tracking-[0.12em] text-[#888] mb-4 block">Our process</span>
          <h2 class="text-[32px] font-semibold text-white tracking-[-1.28px] leading-[40px] mb-4">Three phases to a compounding profit engine.</h2>
          <p class="text-[18px] text-[#888] max-w-xl mx-auto leading-[28px]">We don't blast ads day one. We build infrastructure first, then scale with discipline.</p>
        </div>

        <div class="space-y-4">
          {[
            {
              num: "Phase 01",
              tag: "Days 1-14",
              title: "Foundation & audit.",
              body: "We audit your current ad accounts, configure server-side tracking, build your MER dashboard, and establish creative testing cadence. No new spend until attribution is clean and baseline CAC is calculated.",
              code: `// Phase 01 deliverables
audit: {
  current_roas_vs_mer:   "calculated",
  attribution_gaps:      "identified",
  audience_overlap:      "fixed",
  creative_fatigue:      "diagnosed"
},
infrastructure: {
  server_side_pixel:     "deployed",
  mer_dashboard:         "live",
  creative_pipeline:     "activated"
}`,
              color: "#007cf0",
            },
            {
              num: "Phase 02",
              tag: "Days 15-90",
              title: "Optimize & reduce CAC.",
              body: "5 new creatives tested per week. Winning audiences isolated. Budgets reallocated to what's actually moving MER. You see data-backed CAC reduction within 3-4 weeks with weekly reporting.",
              code: `// Phase 02 weekly rhythm
monday:    creative_launch(5_new_hooks);
wednesday: performance_review();
           kill_losers(); scale_winners();
friday:    mer_check();
           if (mer < 3.5) { reoptimize(); }
           else { prepare_scale(); }

// Target: CAC down 38% by day 90`,
              color: "#7928ca",
            },
            {
              num: "Phase 03",
              tag: "Month 3+",
              title: "Scale with discipline.",
              body: "Once your MER is consistently above 3.5x and CAC is trending down, we expand to new channels, new markets, and retention sequences. Every dollar of new spend earns its place with a documented return.",
              code: `// Scale criteria -- non-negotiable:
const canScale = (
  mer >= 3.5         &&   // True MER threshold
  cac_trend === "down" && // CAC still falling
