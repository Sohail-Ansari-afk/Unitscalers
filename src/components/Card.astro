---
interface Props {
  title: string;
  class?: string;
}

const { title, class: className = '' } = Astro.props;
---

<div class={`border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 md:p-8 hover:border-gray-300 dark:hover:border-gray-700 transition-colors ${className}`}>
  <h3 class="text-xl font-bold mb-4 font-sans tracking-tight text-brand-dark dark:text-white">{title}</h3>
  <div class="text-gray-600 dark:text-gray-400 prose-sm dark:prose-invert">
    <slot />
  </div>
</div>
