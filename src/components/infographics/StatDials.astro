---
/**
 * Enhanced Stat Dials — colorful metric cards with accent bars
 * Used on: Digital Brands page
 */
interface Props {
  stats: { label: string; value: string; subtext: string }[];
}

const { stats } = Astro.props;

const accentColors = ["#2d9470", "#5aac96", "#8ec5b5", "#d1e8e2"];
---

<div class={`grid gap-4 ${stats.length === 3 ? 'grid-cols-1 sm:grid-cols-3' : 'grid-cols-2 sm:grid-cols-4'}`}>
  {stats.map((stat, i) => {
    const color = accentColors[i % accentColors.length];
    return (
      <div class="relative overflow-hidden bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800">
        <div class="h-1" style={`background-color: ${color};`}></div>
        <div class="p-4 sm:p-6 text-center">
          <div class="font-mono text-3xl sm:text-4xl font-bold text-brand-dark dark:text-white mb-1">{stat.value}</div>
          <div class="font-mono text-[10px] uppercase tracking-widest mb-2" style={`color: ${color};`}>{stat.label}</div>
          <div class="text-[11px] text-gray-400 dark:text-gray-500 leading-tight">{stat.subtext}</div>
        </div>
      </div>
    );
  })}
</div>
