---
/**
 * D2C Growth Stack — visual breakdown of services
 * Used on: Digital Brands page
 */
const channels = [
  { name: "Google Ads", desc: "Captures high-intent buyers", pct: 30, color: "#2d9470" },
  { name: "Meta Ads", desc: "Builds discovery & story", pct: 25, color: "#5aac96" },
  { name: "SEO", desc: "Compounds organic traffic", pct: 20, color: "#8ec5b5" },
  { name: "AEO/GEO", desc: "AI citation & visibility", pct: 15, color: "#b8d8cf" },
  { name: "Website", desc: "Converts all traffic", pct: 10, color: "#d1e8e2" },
];
---

<div class="w-full max-w-xl mx-auto">
  <div class="font-mono text-xs uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-6 text-center">Typical D2C Budget Allocation</div>
  
  <!-- Stacked bar -->
  <div class="flex h-12 sm:h-14 overflow-hidden border border-gray-200 dark:border-gray-700 mb-6">
    {channels.map((ch) => (
      <div
        class="flex items-center justify-center relative group"
        style={`width: ${ch.pct}%; background-color: ${ch.color};`}
      >
        <span class="font-mono text-[10px] sm:text-xs font-bold text-brand-dark leading-tight text-center px-1">{ch.pct}%</span>
      </div>
    ))}
  </div>

  <!-- Legend -->
  <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
    {channels.map((ch) => (
      <div class="flex items-start gap-2">
        <div class="w-3 h-3 mt-1 flex-shrink-0 border border-gray-300 dark:border-gray-600" style={`background-color: ${ch.color};`}></div>
        <div>
          <div class="font-mono text-xs font-bold text-brand-dark dark:text-gray-200">{ch.name}</div>
          <div class="text-[11px] text-gray-500 dark:text-gray-400 leading-tight">{ch.desc}</div>
        </div>
      </div>
    ))}
  </div>
  
  <p class="font-mono text-[10px] text-gray-400 dark:text-gray-600 text-center mt-6 uppercase tracking-wider">
    Allocation varies by stage — audit determines your mix
  </p>
</div>
