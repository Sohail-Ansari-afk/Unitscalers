---
// Footer + Final CTA — UnitScalers D2C Agency
---

<!-- Final CTA Band -->
<section id="contact" class="bg-[#fafafa] py-24 border-t border-[#ebebeb]">
  <div class="max-w-[1200px] mx-auto px-6">
    <div 
      class="relative rounded-2xl overflow-hidden p-12 md:p-20 text-center"
      style="background: #171717;"
    >
      <!-- Mesh gradient backdrop -->
      <div 
        class="absolute inset-0 pointer-events-none"
        aria-hidden="true"
        style="
          background:
            radial-gradient(ellipse 70% 60% at 15% 50%, rgba(0,124,240,0.28) 0%, transparent 60%),
            radial-gradient(ellipse 60% 50% at 85% 50%, rgba(121,40,202,0.22) 0%, transparent 55%),
            radial-gradient(ellipse 50% 80% at 50% -20%, rgba(0,223,216,0.18) 0%, transparent 60%),
            radial-gradient(ellipse 60% 60% at 50% 120%, rgba(255,0,128,0.14) 0%, transparent 60%);
          animation: mesh-drift 16s ease-in-out infinite;
        "
      ></div>

      <div class="relative z-10">
        <span class="text-[11px] font-mono uppercase tracking-[0.12em] text-[#888] mb-6 block">Work with us</span>
        <h2 class="text-[40px] md:text-[52px] font-semibold text-white tracking-[-2px] leading-[1.05] mb-6">
          Stop burning ad spend.<br/>Start engineering net profit.
        </h2>
        <p class="text-[17px] text-[#888] max-w-xl mx-auto leading-[28px] mb-10">
          Join 40+ Indian D2C brands that scaled from ₹5L to ₹50L/month with UnitScalers managing their performance marketing.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a 
            href="#audit"
            id="cta-final-audit"
            class="h-12 px-8 rounded-full bg-white text-[#171717] text-[16px] font-medium flex items-center gap-2 hover:bg-[#f0f0f0] transition-all duration-200 hover:scale-[1.02]"
          >
            Claim Your Free 5-Min Audit
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a 
            href="#pricing"
            id="cta-final-pricing"
            class="h-12 px-8 rounded-full border border-[#444] text-[#888] text-[16px] font-medium flex items-center gap-2 hover:border-[#888] hover:text-white transition-all duration-200"
          >
            See Pricing
          </a>
        </div>
        <p class="text-[12px] text-[#555] mt-6 font-mono">No commitment · Response within 24 hours · Based in India, serving Indian D2C brands</p>
      </div>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="bg-white border-t border-[#ebebeb] py-16">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 mb-12">
      <!-- Brand column -->
      <div class="col-span-2 md:col-span-1">
        <div class="flex items-center gap-2.5 mb-4">
          <div class="w-6 h-6 rounded-md flex items-center justify-center" style="background: linear-gradient(135deg, #007cf0 0%, #00dfd8 40%, #7928ca 70%, #ff0080 100%);">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M6 1.5L11 10.5H1L6 1.5Z" fill="white"/></svg>
          </div>
          <span class="text-[14px] font-semibold text-[#171717]">UnitScalers</span>
        </div>
        <p class="text-[13px] text-[#888] leading-[20px] mb-4">
          Performance marketing agency for Indian D2C brands. We engineer net profit, not vanity metrics.
        </p>
        <div class="flex items-center gap-1 text-[12px] text-[#888]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#50e3c2]" style="animation: pulse-ring 2s ease-in-out infinite;"></span>
          <span>Taking new clients</span>
        </div>
      </div>

      <!-- Services -->
      <div>
        <h4 class="text-[11px] font-mono uppercase tracking-[0.12em] text-[#888] mb-4">Services</h4>
        <ul class="space-y-2.5">
          {["Meta Ads", "Google Shopping", "YouTube", "WhatsApp Retargeting", "Creative Testing"].map(link => (
            <li><a href="#solution" class="text-[13px] text-[#4d4d4d] hover:text-[#171717] transition-colors">{link}</a></li>
          ))}
        </ul>
      </div>

      <!-- Solutions -->
      <div>
        <h4 class="text-[11px] font-mono uppercase tracking-[0.12em] text-[#888] mb-4">Solutions</h4>
        <ul class="space-y-2.5">
          {["CAC Reduction", "RTO Minimization", "Server-side Attribution", "MER Tracking", "COD Optimization"].map(link => (
            <li><a href="#solution" class="text-[13px] text-[#4d4d4d] hover:text-[#171717] transition-colors">{link}</a></li>
          ))}
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="text-[11px] font-mono uppercase tracking-[0.12em] text-[#888] mb-4">Company</h4>
        <ul class="space-y-2.5">
          {["About", "Case Studies", "Blog", "Careers", "Contact"].map(link => (
            <li><a href="#contact" class="text-[13px] text-[#4d4d4d] hover:text-[#171717] transition-colors">{link}</a></li>
          ))}
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h4 class="text-[11px] font-mono uppercase tracking-[0.12em] text-[#888] mb-4">Legal</h4>
        <ul class="space-y-2.5">
          {["Privacy Policy", "Terms of Service", "Cookie Policy"].map(link => (
            <li><a href="#" class="text-[13px] text-[#4d4d4d] hover:text-[#171717] transition-colors">{link}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pt-8 border-t border-[#ebebeb]">
      <p class="text-[12px] text-[#888]">
        © 2025 UnitScalers. Performance marketing for Indian D2C brands. Maharashtra, India.
      </p>
      <div class="flex flex-wrap gap-4">
        {["NIST SP 811", "ISO 80000", "BIPM"].map(badge => (
          <span class="text-[11px] font-mono text-[#888] bg-[#fafafa] border border-[#ebebeb] rounded-full px-2 py-0.5">{badge}</span>
        ))}
      </div>
    </div>
  </div>
</footer>
