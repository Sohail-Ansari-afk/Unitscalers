---
interface Props {
  label: string;
  value: string;
}

const { label, value } = Astro.props;
---

<div class="flex items-center gap-4 py-3 border-b border-gray-100 dark:border-gray-800 last:border-0">
  <span class="font-mono text-xs uppercase tracking-widest text-gray-400 dark:text-gray-500 w-1/3">{label}</span>
  <span class="font-sans font-medium text-brand-dark dark:text-gray-200 w-2/3">{value}</span>
</div>
