---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const { 
  title = "UnitScalers — Stop Chasing GMV. Start Engineering Net Profit.",
  description = "The premier performance marketing agency for Indian D2C brands. We reduce CAC, minimize RTO, and align every rupee of ad spend with your P&L."
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IN" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <!-- JSON-LD Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "UnitScalers",
        "description": "The premier performance marketing agency for D2C brands in India. We specialize in reducing customer acquisition costs, optimizing contribution margins, and driving profitable growth for Shopify stores.",
        "url": "https://unitscalers.com",
        "priceRange": "\u20B9\u20B9\u20B9",
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "IN",
          "addressRegion": "Maharashtra"
        },
        "knowsAbout": [
          "Performance Marketing India",
          "D2C Brand Scaling",
          "Customer Acquisition Cost Optimization",
          "RTO Cost Reduction",
          "Shopify Media Buying"
        ]
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
