---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
  schema?: string;
}
const { 
  title = "UnitScalers — LinkedIn Growth, Run Like Performance Marketing",
  description = "UnitScalers builds and manages LinkedIn presence for founders and entrepreneurs — content, carousels, and outreach — tracked with the same attribution discipline as a paid ad account.",
  schema
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://unitscalers.com').href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="en_US" />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <!-- Primary JSON-LD Schema -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        "name": "UnitScalers",
        "description": "A LinkedIn management agency for founders and entrepreneurs, combining content, carousel design, and outreach with performance-marketing-style attribution reporting.",
        "url": "https://unitscalers.com",
        "areaServed": "Global",
        "knowsAbout": [
          "LinkedIn Content Strategy",
          "Personal Branding for Founders",
          "LinkedIn Carousel Design",
          "B2B Lead Generation",
          "LinkedIn Outreach Systems",
          "Performance Marketing Attribution"
        ]
      }
    </script>
    <!-- Additional schema (FAQPage etc.) passed via prop -->
    {schema && <script type="application/ld+json" set:html={schema} />}
  </head>
  <body>
    <slot />
  </body>
</html>
